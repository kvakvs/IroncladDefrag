Checks: >-
  -*,
  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  bugprone-*,
  performance-*,
  readability-function-cognitive-complexity
# EnumCastOutOfRange is an opt-in check that does not understand bit-flag enums: it reports OR-ed flags
# inside the MSVC STL (<filesystem>, __std_fs_stats_flags) wherever std::filesystem is used.
WarningsAsErrors: '*'
# Only project headers under src/ report; wxWidgets, the STL and the Windows SDK are not ours.
HeaderFilterRegex: '(^|[/\\])src[/\\]'
CheckOptions:
  readability-function-cognitive-complexity.Threshold: 10
  readability-function-cognitive-complexity.DescribeBasicIncrements: true
  # Allocation failures are fatal; the check already ignores bad_alloc. MSVC's map/set move constructors allocate a
  # sentinel node and can throw bad_array_new_length, so implicit moves of structs holding them would be reported.
  bugprone-exception-escape.IgnoredExceptions: 'bad_array_new_length'
