# Writes a C++ source that returns a text file's contents (cmake -P script mode), so data files such as
# data/classes.json are built into the program instead of being looked up at run time.
#   -DINPUT=<file> -DOUTPUT=<generated .cpp> -DNAMESPACE=<C++ namespace> -DFUNCTION=<function name>
# The bytes go into a char array (string literals have length limits in MSVC).
file(READ "${INPUT}" HEX HEX)
string(LENGTH "${HEX}" HEX_LENGTH)
math(EXPR BYTES "${HEX_LENGTH} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," ARRAY "${HEX}")
# Break the array into lines of 24 bytes (5 characters per byte).
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n        " ARRAY "${ARRAY}")
file(WRITE "${OUTPUT}.tmp"
"// Generated by cmake/EmbedText.cmake from ${INPUT}; do not edit.
#include <string_view>

namespace ${NAMESPACE} {

    namespace {

        // The file's bytes plus a terminating zero.
        constexpr char text[] = {
        ${ARRAY}0x00};

    } // namespace

    std::string_view ${FUNCTION}() { return {text, ${BYTES}}; }

} // namespace ${NAMESPACE}
")
# Only replace the output when it changed, so unchanged data does not rebuild anything.
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
