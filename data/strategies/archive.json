{
  "version": 1,
  "id": "archive",
  "name": "Archive and disk images",
  "description": "Plan.md 8.4: archives, disc images and backups written once and read sequentially, each made contiguous (fragments of 64 MB or more are left) and packed; VM disks after them with room to grow; unknown files defragmented where they are.",
  "zones": [
    { "name": "Directories", "select": { "classes": ["directories"] }, "action": "sort", "anchor": "front",
      "order": "directory+name" },
    { "name": "Churn", "select": { "classes": ["build", "temp", "logs"] }, "action": "keep-in-place" },
    { "name": "Small files", "select": { "classes": ["source", "repository", "dependencies", "catalogs", "photos"] },
      "action": "fast-fill" },
    { "name": "Archives and images",
      "select": { "classes": ["archives", "disc-images", "backups", "dumps", "video"] },
      "action": "fast-fill" },
    { "name": "VM disks", "select": { "classes": ["vm-disks"] }, "action": "fast-fill",
      "gapAfter": { "freePercent": 5 } },
    { "name": "Unknown", "select": { "classes": ["unknown"] }, "action": "defragment-only" }
  ]
}
