{
  "version": 1,
  "id": "access-time",
  "name": "Access-time sort",
  "description": "Plan.md 8.8: files sorted by last access, most recently read first. Only useful where the volume keeps access times (see the Summary tab).",
  "zones": [
    {
      "name": "Directories",
      "select": {
        "classes": [
          "directories"
        ]
      },
      "action": "sort",
      "anchor": "front",
      "order": "directory+name"
    },
    {
      "name": "Churn",
      "select": {
        "classes": [
          "build",
          "temp"
        ]
      },
      "action": "keep-in-place"
    },
    {
      "name": "Files",
      "action": "sort",
      "order": "accessed"
    }
  ]
}
