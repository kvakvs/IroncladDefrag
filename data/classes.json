{
  "version": 1,
  "about": "Built-in file classes and classification rules (plan.md 8.2-8.6). Rules are tried in order; the first match gives the class. Paths are globs from the volume root ('**' = any number of folders, '*' and '?' within a name, case-insensitive). Sizes are bytes or strings such as \"100 MB\" (binary units). \"markers\" are names of entries that show a software project: without \"folders\" the file must be in or below a directory that holds one; with \"folders\" it must be in or below such a folder whose parent holds one (\"target\" next to Cargo.toml). \"inProject\" adds projectMarkers to a rule's markers, so development file types count only inside a project.",
  "projectMarkers": [".git", ".hg", ".svn", "Makefile", "GNUmakefile", "CMakeLists.txt", "meson.build", "configure.ac",
                     "*.sln", "*.slnx", "*.*proj", "Directory.Build.props", "Cargo.toml", "package.json", "deno.json",
                     "go.mod", "pyproject.toml", "setup.py", "setup.cfg", "requirements.txt", "Pipfile", "mix.exs",
                     "rebar.config", "erlang.mk", "pom.xml", "build.gradle", "build.gradle.kts", "settings.gradle",
                     "settings.gradle.kts", "build.xml", "build.sbt", "project.clj", "deps.edn", "stack.yaml",
                     "*.cabal", "cabal.project", "dune-project", "build.zig", "Package.swift", "WORKSPACE",
                     "WORKSPACE.bazel", "MODULE.bazel", "pubspec.yaml", "*.xcodeproj", "*.xcworkspace", "Gemfile",
                     "composer.json"],
  "classes": [
    { "id": "unknown", "name": "Unknown", "color": "#8C8C8C",
      "description": "Anything no other class matches; defragmented in place, never relocated." },
    { "id": "metadata", "name": "NTFS metadata", "color": "#5A5A6E",
      "description": "$MFT, $LogFile and the other NTFS system files; never moved." },
    { "id": "directories", "name": "Directories", "color": "#C8A2C8",
      "description": "Directory indexes; read on every path lookup, so they go first." },
    { "id": "source", "name": "Source and config", "color": "#4C9BE8",
      "description": "Sources, headers, scripts, project files and docs inside software projects: small, stable, read often." },
    { "id": "repository", "name": "Repository data", "color": "#2E6FB7",
      "description": "Git pack files and their indexes: large, read often, rewritten rarely." },
    { "id": "dependencies", "name": "Dependencies", "color": "#6FB7B7",
      "description": "node_modules, virtual environments, package caches and vendored code: many small, semi-stable files." },
    { "id": "build", "name": "Build output", "color": "#E8A23C",
      "description": "Build folders of software projects, object files, bytecode and debug information: rewritten all the time (churn), kept in place." },
    { "id": "temp", "name": "Temp", "color": "#E8D33C",
      "description": "Temporary files, caches, editor leftovers, partial downloads, loose Git objects and anything the change journal shows as churn." },
    { "id": "logs", "name": "Logs", "color": "#C2B280",
      "description": "Log and trace files: appended all the time and so fragmented; kept in place with the churn." },
    { "id": "archives", "name": "Archives", "color": "#9C6B3C",
      "description": "Compressed archives: written once, read sequentially." },
    { "id": "disc-images", "name": "Disc images", "color": "#B5835A",
      "description": "ISO and other disc images: written once, read sequentially." },
    { "id": "vm-disks", "name": "VM disks", "color": "#7A4E2D",
      "description": "Virtual machine disks; fixed-size ones fully defragmented, growing ones at the zone's end." },
    { "id": "backups", "name": "Backups", "color": "#6E5A46",
      "description": "Backup and system image files." },
    { "id": "dumps", "name": "Dumps", "color": "#B24A4A",
      "description": "Crash and memory dumps, wherever programs run: large, written once, rarely read; placed cold." },
    { "id": "photos", "name": "Photos", "color": "#5FB760",
      "description": "Photos, RAW files and sidecars: sorted by folder, then name." },
    { "id": "catalogs", "name": "Catalogs and thumbnails", "color": "#E85C8A",
      "description": "Photo catalogs, previews and thumbnail caches: hot, placed in the fast zone." },
    { "id": "video", "name": "Video", "color": "#8A5CE8",
      "description": "Videos of any size and large GIF animations: packed at the end of the volume." }
  ],
  "fallback": "unknown",
  "rules": [
    { "name": "NTFS metadata", "class": "metadata", "flags": ["metadata"] },
    { "name": "Directories", "class": "directories", "flags": ["directory"] },
    { "name": "Crash and memory dumps", "class": "dumps",
      "extensions": ["dmp", "mdmp", "hdmp", "hprof", "stackdump", "dump"] },
    { "name": "Crash reports and dump folders", "class": "dumps",
      "paths": ["**/hs_err_pid*.log", "**/javacore*.txt", "**/CrashDumps/**", "**/Minidump/**",
                "**/Minidumps/**", "**/Crash Reports/**", "**/CrashReports/**", "**/WER/**",
                "**/LiveKernelReports/**"] },
    { "name": "Core dumps", "class": "dumps", "paths": ["**/core"], "notFlags": ["directory"], "minSize": "1 MB" },

    { "name": "Dependency folders", "class": "dependencies",
      "paths": ["**/node_modules/**", "**/bower_components/**", "**/.pnpm-store/**", "**/.nuget/packages/**",
                "**/.cargo/registry/**", "**/.cargo/git/**", "**/.m2/repository/**", "**/.gradle/caches/**",
                "**/.hex/packages/**", "**/site-packages/**", "**/pip/cache/**", "**/vcpkg_installed/**"] },
    { "name": "Python virtual environments", "class": "dependencies", "markers": ["pyvenv.cfg", "conda-meta"] },
    { "name": "Vendored and fetched dependencies", "class": "dependencies", "folders": ["vendor"],
      "markers": ["go.mod", "composer.json", "Gemfile", "Cargo.toml"] },
    { "name": "Mix dependencies", "class": "dependencies", "folders": ["deps"], "markers": ["mix.exs"] },
    { "name": "CocoaPods", "class": "dependencies", "folders": ["Pods"], "markers": ["Podfile"] },
    { "name": "NuGet packages folder", "class": "dependencies", "folders": ["packages"],
      "markers": ["*.sln", "packages.config"] },

    { "name": "Build and cache folders", "class": "build",
      "paths": ["**/__pycache__/**", "**/.pytest_cache/**", "**/.mypy_cache/**", "**/.ruff_cache/**", "**/.tox/**",
                "**/.nox/**", "**/.ipynb_checkpoints/**", "**/CMakeFiles/**", "**/.terraform/**",
                "**/.angular/cache/**", "**/.vs/**"] },
    { "name": "Rust, Maven, sbt and Leiningen build output", "class": "build", "folders": ["target"],
      "markers": ["Cargo.toml", "pom.xml", "build.sbt", "project.clj"] },
    { "name": "Mix, rebar3 and dune build output", "class": "build", "folders": ["_build"],
      "markers": ["mix.exs", "rebar.config", "dune-project"] },
    { "name": "Erlang build output", "class": "build", "folders": ["ebin"],
      "markers": ["rebar.config", "erlang.mk", "Makefile", "Emakefile"] },
    { "name": "Node build output and caches", "class": "build",
      "folders": ["dist", "build", "out", ".next", ".nuxt", ".svelte-kit", ".turbo", ".parcel-cache", ".angular",
                  ".vite", "coverage"],
      "markers": ["package.json"] },
    { "name": "Python build output", "class": "build", "folders": ["build", "dist", "*.egg-info", ".eggs"],
      "markers": ["pyproject.toml", "setup.py", "setup.cfg"] },
    { "name": "Gradle build output", "class": "build", "folders": ["build", ".gradle"],
      "markers": ["build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts"] },
    { "name": "CMake and Meson build trees", "class": "build",
      "folders": ["build", "build?", "build-*", "build_*", "cmake-build-*", "out", "builddir"],
      "markers": ["CMakeLists.txt", "meson.build"] },
    { "name": "MSBuild output", "class": "build",
      "folders": ["bin", "obj", "Debug", "Release", "x64", "x86", "Win32", "ARM64", "ipch"],
      "markers": ["*.sln", "*.slnx", "*.*proj"] },
    { "name": "Haskell build output", "class": "build", "folders": [".stack-work", "dist-newstyle", "dist"],
      "markers": ["stack.yaml", "*.cabal", "cabal.project"] },
    { "name": "Zig build output", "class": "build", "folders": ["zig-out", ".zig-cache", "zig-cache"],
      "markers": ["build.zig"] },
    { "name": "SwiftPM build output", "class": "build", "folders": [".build"], "markers": ["Package.swift"] },
    { "name": "Bazel output", "class": "build", "folders": ["bazel-*"],
      "markers": ["WORKSPACE", "WORKSPACE.bazel", "MODULE.bazel"] },
    { "name": "Dart and Flutter build output", "class": "build", "folders": [".dart_tool", "build"],
      "markers": ["pubspec.yaml"] },
    { "name": "Xcode build output", "class": "build", "folders": ["DerivedData", "build"],
      "markers": ["*.xcodeproj", "*.xcworkspace"] },
    { "name": "Git packs", "class": "repository",
      "paths": ["**/.git/objects/pack/*"], "extensions": ["pack", "idx"] },
    { "name": "Loose Git objects", "class": "temp", "paths": ["**/.git/objects/??/*"] },
    { "name": "Other Git data (refs, index, config, hooks, tool indexes)", "class": "repository",
      "paths": ["**/.git/**"] },
    { "name": "Build files in projects", "class": "build", "inProject": true,
      "extensions": ["obj", "o", "pch", "ipch", "gch", "pcm", "ifc", "ilk", "exp", "idb", "tlog", "lastbuildstate",
                     "iobj", "ipdb", "class", "pyc", "pyo", "beam", "hi", "dyn_hi", "dyn_o", "cmi", "cmo", "cmx",
                     "cmt", "cmti", "tsbuildinfo", "exe", "dll", "lib", "a", "so", "dylib", "pyd", "wasm"] },
    { "name": "Debug information in projects", "class": "build", "inProject": true,
      "extensions": ["pdb", "debug", "sym"] },
    { "name": "Debug symbol bundles and source maps in projects", "class": "build", "inProject": true,
      "paths": ["**/*.dSYM/**", "**/*.js.map", "**/*.mjs.map", "**/*.cjs.map", "**/*.css.map"] },

    { "name": "Temp folders and names", "class": "temp",
      "paths": ["**/~*", "**/*~", "**/#*#", "**/.#*", "**/.DS_Store", "**/.cache/**", "**/Temp/**", "**/tmp/**"] },
    { "name": "Browser and app caches", "class": "temp",
      "paths": ["**/User Data/*/Cache/**", "**/AppData/*/*/Cache/**", "**/Code Cache/**", "**/GPUCache/**",
                "**/ShaderCache/**", "**/GrShaderCache/**", "**/DawnCache/**", "**/DawnGraphiteCache/**",
                "**/CacheStorage/**", "**/INetCache/**", "**/cache2/**"] },
    { "name": "Temp files, leftovers and partial downloads", "class": "temp",
      "extensions": ["tmp", "temp", "swp", "swo", "orig", "rej", "crdownload", "part", "partial"] },

    { "name": "Logs and traces", "class": "logs", "extensions": ["log", "etl", "evtx"] },

    { "name": "Churn from the change journal", "class": "temp", "churn": "churning" },
    { "name": "Photo catalogs and previews", "class": "catalogs",
      "paths": ["**/*.lrdata/**", "**/Thumbs.db", "**/thumbcache_*.db", "**/.thumbnails/**"],
      "extensions": [] },
    { "name": "Photo catalog files", "class": "catalogs", "extensions": ["lrcat", "lrcat-data", "cocatalog"] },
    { "name": "Photos", "class": "photos",
      "extensions": ["jpg", "jpeg", "png", "heic", "heif", "webp", "tif", "tiff", "psd", "cr2", "cr3", "nef", "arw",
                     "orf", "raf", "rw2", "dng", "xmp"] },
    { "name": "Video", "class": "video",
      "extensions": ["mp4", "m4v", "mkv", "mk3d", "mov", "qt", "avi", "divx", "wmv", "asf", "webm", "flv", "f4v",
                     "mpg", "mpeg", "m2v", "m2p", "m2ts", "m2t", "3gp", "3g2", "ogv", "mxf", "dv", "rmvb", "tod"] },
    { "name": "DVD, HD DVD and Blu-ray streams", "class": "video", "extensions": ["vob", "vro", "evo", "ssif"] },
    { "name": "Streams named like code", "class": "video", "minSize": "10 MB", "extensions": ["ts", "mts", "mod"] },
    { "name": "GIF animations", "class": "video", "minSize": "10 MB", "extensions": ["gif"] },
    { "name": "Archives", "class": "archives",
      "extensions": ["zip", "7z", "rar", "tar", "gz", "tgz", "bz2", "xz", "zst", "cab"] },
    { "name": "Rotated logs (after archives, so app.log.gz stays an archive)", "class": "logs",
      "paths": ["**/*.log.?", "**/*.log.??"] },
    { "name": "Disc images", "class": "disc-images", "extensions": ["iso", "cue", "mdf", "mds", "nrg", "cdi"] },
    { "name": "Disc images named like data files", "class": "disc-images", "minSize": "1 MB",
      "extensions": ["img", "bin"] },
    { "name": "VM disks", "class": "vm-disks", "extensions": ["vhd", "vhdx", "avhdx", "vmdk", "vdi", "qcow2"] },
    { "name": "Backups", "class": "backups", "extensions": ["bak", "wim", "esd", "tib", "vbk"] },
    { "name": "Source names without an extension", "class": "source", "inProject": true,
      "paths": ["**/Makefile", "**/GNUmakefile", "**/Dockerfile", "**/Rakefile", "**/Gemfile", "**/Podfile",
                "**/Procfile", "**/Vagrantfile", "**/Jenkinsfile", "**/Justfile", "**/WORKSPACE", "**/README",
                "**/LICENSE", "**/COPYING", "**/AUTHORS", "**/NOTICE", "**/CHANGELOG", "**/CHANGES", "**/NEWS",
                "**/INSTALL", "**/CONTRIBUTING", "**/VERSION", "**/.gitignore", "**/.gitattributes",
                "**/.gitmodules", "**/.dockerignore", "**/.editorconfig", "**/.clang-format", "**/.clang-tidy",
                "**/.npmrc", "**/.nvmrc", "**/.tool-versions", "**/.env.example"] },
    { "name": "Source and config in projects", "class": "source", "inProject": true,
      "extensions": ["c", "cc", "cpp", "cxx", "h", "hh", "hpp", "hxx", "inl", "ipp", "ixx", "cppm", "cs", "vb", "fs",
                     "java", "kt", "kts", "scala", "sbt", "clj", "cljs", "edn", "go", "rs", "swift", "m", "mm", "py",
                     "pyi", "rb", "php", "pl", "pm", "lua", "zig", "hs", "cabal", "ml", "mli", "erl", "hrl", "ex",
                     "exs", "eex", "heex", "dart", "js", "jsx", "ts", "tsx", "mts", "cts", "mjs", "cjs", "vue",
                     "svelte", "css", "scss", "sass", "less", "html", "htm", "xml", "xaml", "json", "yaml", "yml",
                     "toml", "ini", "cfg", "conf", "config", "props", "targets", "sln", "slnx", "vcxproj", "csproj",
                     "fsproj", "vbproj", "filters", "cmake", "mk", "gradle", "bazel", "bzl", "sh", "bash", "zsh",
                     "ps1", "psm1", "psd1", "bat", "cmd", "sql", "md", "markdown", "rst", "txt", "adoc", "tex", "rc",
                     "def", "idl", "proto", "lock", "iml", "inc", "in", "am", "ac", "m4", "s", "asm", "asn", "asn1",
                     "src", "appup", "spec", "mib", "xsd", "xsl", "xslt", "dtd", "svg", "gql", "graphql", "j2",
                     "jinja", "tmpl", "tpl", "mustache", "hbs", "erb", "ejs", "pem", "pub"] }
  ]
}
