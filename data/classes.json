{
  "version": 1,
  "about": "Built-in file classes and classification rules (plan.md 8.2-8.6). Rules are tried in order; the first match gives the class. Paths are globs from the volume root ('**' = any number of folders, '*' and '?' within a name, case-insensitive). Sizes are bytes or strings such as \"100 MB\" (binary units).",
  "classes": [
    { "id": "unknown", "name": "Unknown", "color": "#8C8C8C",
      "description": "Anything no other class matches; defragmented in place, never relocated." },
    { "id": "metadata", "name": "NTFS metadata", "color": "#5A5A6E",
      "description": "$MFT, $LogFile and the other NTFS system files; never moved." },
    { "id": "directories", "name": "Directories", "color": "#C8A2C8",
      "description": "Directory indexes; read on every path lookup, so they go first." },
    { "id": "source", "name": "Source and config", "color": "#4C9BE8",
      "description": "Sources, headers, scripts, project and solution files, docs: small, stable, read often." },
    { "id": "repository", "name": "Repository data", "color": "#2E6FB7",
      "description": "Git pack files and their indexes: large, read often, rewritten rarely." },
    { "id": "dependencies", "name": "Dependencies", "color": "#6FB7B7",
      "description": "node_modules, package caches and vendored code: many small, semi-stable files." },
    { "id": "build", "name": "Build output", "color": "#E8A23C",
      "description": "Object files, PDBs and build folders: rewritten all the time (churn), kept in place." },
    { "id": "temp", "name": "Temp", "color": "#E8D33C",
      "description": "Temporary and cache files, loose Git objects and anything the change journal shows as churn." },
    { "id": "archives", "name": "Archives", "color": "#9C6B3C",
      "description": "Compressed archives: written once, read sequentially." },
    { "id": "disc-images", "name": "Disc images", "color": "#B5835A",
      "description": "ISO and other disc images: written once, read sequentially." },
    { "id": "vm-disks", "name": "VM disks", "color": "#7A4E2D",
      "description": "Virtual machine disks; fixed-size ones fully defragmented, growing ones at the zone's end." },
    { "id": "backups", "name": "Backups", "color": "#6E5A46",
      "description": "Backup and system image files." },
    { "id": "photos", "name": "Photos", "color": "#5FB760",
      "description": "Photos, RAW files and sidecars: sorted by folder, then name." },
    { "id": "catalogs", "name": "Catalogs and thumbnails", "color": "#E85C8A",
      "description": "Photo catalogs, previews and thumbnail caches: hot, placed in the fast zone." },
    { "id": "video", "name": "Video", "color": "#8A5CE8",
      "description": "Videos of any size and large GIF animations: packed at the end of the volume." }
  ],
  "fallback": "unknown",
  "rules": [
    { "name": "NTFS metadata", "class": "metadata", "flags": ["metadata"] },
    { "name": "Directories", "class": "directories", "flags": ["directory"] },
    { "name": "Git packs", "class": "repository",
      "paths": ["**/.git/objects/pack/*"], "extensions": ["pack", "idx"] },
    { "name": "Loose Git objects", "class": "temp", "paths": ["**/.git/objects/??/*"] },
    { "name": "Dependency folders", "class": "dependencies",
      "paths": ["**/node_modules/**", "**/bower_components/**", "**/.pnpm-store/**", "**/.nuget/packages/**",
                "**/.cargo/registry/**", "**/.cargo/git/**", "**/.m2/repository/**", "**/.gradle/caches/**",
                "**/site-packages/**", "**/pip/cache/**", "**/vendor/**", "**/vcpkg_installed/**"] },
    { "name": "Build folders", "class": "build",
      "paths": ["**/obj/**", "**/bin/**", "**/build/**", "**/out/**", "**/target/**", "**/Debug/**",
                "**/Release/**", "**/x64/**", "**/.vs/**", "**/CMakeFiles/**"] },
    { "name": "Build files", "class": "build",
      "extensions": ["obj", "o", "pch", "ipch", "ilk", "pdb", "idb", "tlog", "lastbuildstate", "iobj", "ipdb"] },
    { "name": "Temp folders and names", "class": "temp",
      "paths": ["**/~*", "**/.cache/**", "**/Temp/**", "**/tmp/**"] },
    { "name": "Temp files", "class": "temp", "extensions": ["tmp", "temp", "swp", "swo"] },
    { "name": "Churn from the change journal", "class": "temp", "churn": "churning" },
    { "name": "Photo catalogs and previews", "class": "catalogs",
      "paths": ["**/*.lrdata/**", "**/Thumbs.db", "**/thumbcache_*.db", "**/.thumbnails/**"],
      "extensions": [] },
    { "name": "Photo catalog files", "class": "catalogs", "extensions": ["lrcat", "lrcat-data", "cocatalog"] },
    { "name": "Photos", "class": "photos",
      "extensions": ["jpg", "jpeg", "png", "heic", "heif", "webp", "tif", "tiff", "psd", "cr2", "cr3", "nef", "arw",
                     "orf", "raf", "rw2", "dng", "xmp"] },
    { "name": "Video", "class": "video",
      "extensions": ["mp4", "m4v", "mkv", "mk3d", "mov", "qt", "avi", "divx", "wmv", "asf", "webm", "flv", "f4v",
                     "mpg", "mpeg", "m2v", "m2p", "m2ts", "m2t", "3gp", "3g2", "ogv", "mxf", "dv", "rmvb", "tod"] },
    { "name": "DVD, HD DVD and Blu-ray streams", "class": "video", "extensions": ["vob", "vro", "evo", "ssif"] },
    { "name": "Streams named like code", "class": "video", "minSize": "10 MB", "extensions": ["ts", "mts", "mod"] },
    { "name": "GIF animations", "class": "video", "minSize": "10 MB", "extensions": ["gif"] },
    { "name": "Archives", "class": "archives",
      "extensions": ["zip", "7z", "rar", "tar", "gz", "tgz", "bz2", "xz", "zst", "cab"] },
    { "name": "Disc images", "class": "disc-images",
      "extensions": ["iso", "img", "bin", "cue", "mdf", "mds", "nrg", "cdi"] },
    { "name": "VM disks", "class": "vm-disks", "extensions": ["vhd", "vhdx", "avhdx", "vmdk", "vdi", "qcow2"] },
    { "name": "Backups", "class": "backups", "extensions": ["bak", "wim", "esd", "tib", "vbk"] },
    { "name": "Source names without an extension", "class": "source",
      "paths": ["**/Makefile", "**/Dockerfile", "**/.gitignore", "**/.gitattributes", "**/.editorconfig",
                "**/.clang-format", "**/.clang-tidy"] },
    { "name": "Source and config", "class": "source",
      "extensions": ["c", "cc", "cpp", "cxx", "h", "hh", "hpp", "hxx", "inl", "ipp", "ixx", "cppm", "cs", "vb", "fs",
                     "java", "kt", "kts", "scala", "go", "rs", "swift", "m", "mm", "py", "pyi", "rb", "php", "pl",
                     "pm", "lua", "js", "jsx", "ts", "tsx", "mts", "cts", "mjs", "cjs", "vue", "svelte", "css", "scss",
                     "sass", "less", "html", "htm", "xml", "xaml", "json", "yaml", "yml", "toml", "ini", "cfg", "conf",
                     "config", "props", "targets", "sln", "slnx", "vcxproj", "csproj", "fsproj", "vbproj", "filters",
                     "cmake", "mk", "gradle", "sh", "bash", "zsh", "ps1", "psm1", "psd1", "bat", "cmd", "sql", "md",
                     "markdown", "rst", "txt", "adoc", "tex", "rc", "def", "idl", "proto"] }
  ]
}
